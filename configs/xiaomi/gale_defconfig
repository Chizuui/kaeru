# Redmi 13C (gale) — MediaTek MT6768
#
# Every address below was derived from THIS device's own lk.img, not copied from
# another board. Load base and size in particular were checked three ways:
#
#   * the LK descriptor at EA 0x6c is { bx r0 ; 0x4C400020 ; 0x4C400000 ;
#     0x4C573C00 ; 0x4C400080 }, and 0x4C573C00 - 0x4C400000 == 0x173C00 which is
#     exactly the size word in the image header, so the base is 0x4C400000.
#   * the Thumb literal at EA 0x42a4 holds 0x76e20 and is consumed by
#     `LDR.W r0,[pc,#..] ; ADD r0,pc`, which resolves to 0x4C400000 + 0x7a824
#     (the "platform_init()\n" string).
#   * mtk_detect_key lands 4 bytes from the same function on the MT6768 earth LK.
#
# get_load_addr() in utils/parse.py looks like it would return the 0x4C400020 that
# sits right after the `bx r0` in that descriptor, but it does not: its return
# statement is `struct.unpack(...) if lk.read(4) else None`, and Python evaluates the
# condition first, so two 4-byte reads happen and the word that gets unpacked is the
# one at +8. That is 0x4C400000, so BOOTLOADER_BASE is correct and running
# utils/setup.py on this image reproduces every value in this file unchanged — with
# the single exception of FASTBOOT_OKAY_ADDRESS, documented below.
#
# Functions confirmed to land exactly on IDA function starts:
#   fastboot_info 0x4C42B680, fastboot_okay 0x4C42BA00, fastboot_publish 0x4C42B22C,
#   video_printf 0x4C42DA1C, mtk_detect_key 0x4C4054A8, thread_create 0x4C4265C8,
#   thread_resume 0x4C4267DC, malloc 0x4C4419E0, free 0x4C441114, dprintf 0x4C440CE4,
#   lk_log_store 0x4C455694, app 0x4C42A9F0 (from the .apps row at EA 0x122E9C).

CONFIG_BOOTLOADER_BASE=0x4C400000
CONFIG_BOOTLOADER_SIZE=0x173C00

# app() is mt_boot_app; the LK names it "mt_boot", which is why parse.py's "app"
# patterns do not match. Found via the .apps table row
# { name="mt_boot", entry=0x4C42A9F1, terminator=0 } at EA 0x122E9C.
CONFIG_APP_ADDRESS=0x4C42A9F0

# platform_init() prologue (PUSH.W {R4-R11,LR}) and the "platform_init()\n" string.
CONFIG_PLATFORM_INIT_ADDRESS=0x4C4039DC

# The BL that platform_init() uses to call init_storage(), at +0x30 into it.
# stage1 NOPs these 4 bytes so storage is not initialized twice, since stage1 has
# already called init_storage() itself before loading stage 2.
CONFIG_INIT_STORAGE_CALLER=0x4C403A0C

# The `bl platform_init` inside LK's bootstrap2. Hand-derived; parse.py cannot find
# it on this LK because its bootstrap2 anchor patterns do not match (see below).
#
# The enclosing function is LK's bootstrap2 tail, reconstructed as:
#
#     dprintf("initializing target\n");        // EA 0x499F78
#     platform_init(args);                     // <-- BL at 0x4C425E0C
#     dprintf("calling apps_init()\n");        // EA 0x499F90
#     apps_init(args);
#
# "initializing target\n" / "calling apps_init()\n" do appear in rodata and are
# referenced from this function, which is what pins the identification. IDA leaves
# this region as data, so the function had to be recovered by decoding byte-aligned
# instructions by hand and validating the call targets: the two callees resolve to
# 0x4C4039DC (CONFIG_PLATFORM_INIT_ADDRESS) and 0x4C440CE4 (CONFIG_DPRINTF_ADDRESS).
#
# Overwriting the 4 bytes here with `bl stage1` is safe because the original BL is
# the first instruction of the function: stage1 returns normally, so execution
# resumes at 0x4C425E10 and dprintf("calling apps_init()") plus apps_init() still run.
# kaeru_early_init() invokes the real platform_init() itself (main/main.c) precisely
# so the skipped call is not lost.
CONFIG_PLATFORM_INIT_CALLER=0x4C425E0C

# fastboot_continue() stores BOOTMODE_NORMAL into it first; lives in BSS, just past
# LK_END (0x4C573C00), exactly like the earth board.
CONFIG_BOOTMODE_ADDRESS=0x4C5765A4

CONFIG_FASTBOOT_REGISTER_ADDRESS=0x4C42B1F0
CONFIG_FASTBOOT_PUBLISH_ADDRESS=0x4C42B22C
CONFIG_FASTBOOT_INFO_ADDRESS=0x4C42B680
# NOTE: utils/parse.py reports 0x4C42B820 for this, which is wrong. Its
# fastboot_okay signature is not discriminative on this LK: both fastboot_okay and
# fastboot_fail compile to the same shape
#
#     mov r1, r0 ; ldr r0, [pc, #8] ; add r0, pc ; b.w <emit>
#
# and the only difference the pattern looks at is the low byte of the branch offset
# (0xBE vs 0xBF). Here the branch is a B.W rather than a BL, so that byte is just
# part of the displacement and the signature matches the wrong function.
#
# Verified by the string each one loads:
#   0x4C42BA00 -> "OKAY"  (12 callers, all success paths)  <- fastboot_okay
#   0x4C42B820 -> "FAIL"  (36 callers, includes both fastboot refusal sites)
# Getting this wrong makes lib/fastboot/fastboot.c emit FAIL for every
# fastboot_okay(), which breaks fastboot entirely.
CONFIG_FASTBOOT_OKAY_ADDRESS=0x4C42BA00

CONFIG_VIDEO_PRINTF_ADDRESS=0x4C42DA1C
CONFIG_MTK_DETECT_KEY_ADDRESS=0x4C4054A8
CONFIG_LK_LOG_STORE_ADDRESS=0x4C455694
CONFIG_THREAD_CREATE_ADDRESS=0x4C4265C8
CONFIG_THREAD_RESUME_ADDRESS=0x4C4267DC
CONFIG_MALLOC_ADDRESS=0x4C4419E0
CONFIG_FREE_ADDRESS=0x4C441114
CONFIG_DPRINTF_ADDRESS=0x4C440CE4

# LK's own environment accessors, called by lib/environment.c to implement
# get_env()/set_env(). Without these the `fastboot oem bldr_spoof on|off|status`
# toggle cannot persist its flag, so the spoof would always read as disabled.
# get_env prints "[%s]get_env %s from area %d\n"; its signature
# (B510 4602 4604 4909) is byte-identical to the one board-next_ultra.c uses for
# get_env, which is a useful independent confirmation.
CONFIG_GET_ENV_ADDRESS=0x4C45C4E8
# set_env prints "[%s]set_env %s %s\n" and "invalid parameter in set_env_with_area".
CONFIG_SET_ENV_ADDRESS=0x4C45C51E

# Cmdline templates rewritten by handle_recovery_boot() when booting recovery, so
# adbd/fastbootd still see "orange" while the lock state is spoofed as locked.
# Both live in the verifiedbootstate switcher at 0x4C454758.
CONFIG_RECOVERY_CMDLINE1_ADDRESS=0x4C516380
CONFIG_RECOVERY_CMDLINE2_ADDRESS=0x4C5163F4

CONFIG_MEDIATEK_MT6768=y
CONFIG_XIAOMI_GALE=y
CONFIG_SPOOF_SUPPORT=y
CONFIG_RECOVERY_CMDLINE_PATCH=y
CONFIG_CERT_BYPASS=y

# ── NOT SET BY utils/parse.py ───────────────────────────────────────────────────
#
# CONFIG_PLATFORM_INIT_CALLER is written by hand above because parse.py's two
# bootstrap2 anchor patterns
#
#     48 XX 10 b5 78 44 XX f0 XX XX XX 4b
#     08 b5 ff f7 38 ea df f7 e3 fb
#
# do not occur anywhere in this LK image (0 hits each), and parse.py guards the
# caller lookup with `if 'bootstrap2' in offsets and 'platform_init' in offsets`.
# Without that anchor it never even tries, so it emits no caller address.
#
# The caller itself is not missing, though: the `bl platform_init` exists at
# 0x4C425E0C and is on the boot path. Verified by decoding every Thumb-2 BL/BLX
# in [0, 0x79388) with a hand-written decoder over 2-byte-aligned offsets (13205
# calls, target histogram sane), which finds exactly one BL to 0x4C4039DC and none
# anywhere else in the image.
#
# What made this look absent: capstone's linear sweep desynchronises on this LK's
# data regions and IDA classifies the surrounding bytes as data, so both were
# untrustworthy. Decoding each candidate offset independently and checking the
# callee against known config addresses is what settled it.
